# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- database -------------------------------------------------------------
# Host-side default matches docker-compose's published port.
# Inside the app container this is overridden to host "postgres".
# Host port for the compose Postgres. Change both of these together if 5432 is
# already in use on your machine (a native Postgres install is the usual cause).
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://muster:muster@localhost:5432/muster

# --- LLM provider ---------------------------------------------------------
# gemini = the working, tested implementation.
# ollama = documented but untested; see README "Running locally without Gemini".
LLM_PROVIDER=gemini

# REQUIRED when LLM_PROVIDER=gemini. Startup fails loudly if absent.
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# native = use the provider's own JSON-schema support (Gemini responseSchema).
# prompt = portable path: schema in the prompt + validation + repair.
# Both are measured; every eval report line carries the mode that produced it.
SCHEMA_MODE=native

# Free-tier request-per-minute caps are real. These bound an eval run.
LLM_MAX_CONCURRENCY=4
LLM_MAX_ATTEMPTS=5
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=60.0
LLM_TIMEOUT_SECONDS=120

# --- funnel ---------------------------------------------------------------
FUNNEL_VALUE_TURN_MIN=2
FUNNEL_VALUE_TURN_MAX=4
FUNNEL_TRANSITION_TURN=5
FUNNEL_HARD_CAP=7
CONVERSATION_IDLE_HOURS=24
# Re-asks after the first invalid phone number (so 3 attempts in total).
PHONE_REASK_LIMIT=2
# Re-asks allowed at TRANSITION before the agent stops asking and just replies.
TRANSITION_REASK_LIMIT=2
# Consecutive inbound messages within this window are treated as one turn.
BURST_WINDOW_SECONDS=5

# --- booking / availability ----------------------------------------------
DEFAULT_TIMEZONE=Europe/Berlin
DEFAULT_PHONE_REGION=DE
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=21:00
SESSION_MINUTES=30
MIN_LEAD_MINUTES=120
BOOKING_HORIZON_DAYS=14

# --- policy ---------------------------------------------------------------
# Confirmed business rule: only senders already present as a lead are answered.
# allow_all | require_lead_record
ELIGIBILITY_POLICY=require_lead_record
# none | on_first_contact | every_message
DISCLOSURE_MODE=on_first_contact
REQUIRE_BOOKING_APPROVAL=true

# --- guardrails -----------------------------------------------------------
REPLY_MIN_WORDS=3
REPLY_MAX_WORDS=40
# The source says 1; its own example uses 3. See decision D39.
REPLY_MAX_SENTENCES=2
GUARDRAIL_RECOMPOSE_LIMIT=2
# Effective confidence below this routes the turn to a human.
CONFIDENCE_THRESHOLD=0.45

# --- memory windows (raw exchanges kept verbatim per agent) ---------------
K_SUPERVISOR=8
K_STRATEGY=6
K_KNOWLEDGE=2

# --- logging --------------------------------------------------------------
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# --- transitive dependency, pinned off deliberately -----------------------
# langsmith arrives via langchain-core and will POST traces to LangSmith's
# cloud if these are ever set true. This project has no external tracing
# backend by design; see decision D9.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
